# 예시 전용. 실제 비밀번호/키는 이 파일에 저장하지 말고 시스템 환경변수로 주입한다.
RAG_DB_DSN=postgresql://raguser:CHANGE_ME@127.0.0.1:5432/ragdb
RAG_API_KEY=CHANGE_ME
RAG_UPLOAD_ROOT=/srv/insurance-rag/uploads
RAG_ARTIFACT_ROOT=/srv/insurance-rag/processed
RAG_EMBED_URL=http://127.0.0.1:8200/v1/embeddings
RAG_EMBED_MODEL=bge-m3
RAG_MAX_UPLOAD_MB=100
RAG_DOCLING_ARTIFACTS=/srv/models/docling
# 사용할 때만 지정. 로컬 FlagReranker 경로
RAG_RERANK_MODEL_PATH=
# Java DRM adapter 실행 파일; 비우면 평문 입력만 처리
RAG_DRM_COMMAND=
