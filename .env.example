# config/profiles 아래의 완결 YAML 하나를 선택한다. 공통 settings.yaml은 사용하지 않는다.
RAG_PROFILE=rockylinux9

# 비밀값 또는 서버별 값만 환경 변수로 주입한다.
RAG_DB_DSN=postgresql://raguser:CHANGE_ME@127.0.0.1:5432/ragdb
# 서버별 영속 저장 경로. 상대경로는 프로젝트 루트 기준으로 해석된다.
RAG_UPLOAD_ROOT=/srv/ecm-rag/uploads
RAG_ARTIFACT_ROOT=/srv/ecm-rag/processed
RAG_WEB_ROOT=web
# 사내망 Java/EAI 검증 전에는 false, 운영 연동 시 true로 변경한다.
RAG_AUTH_ENABLED=false
# provider=python_module에서 JPype가 사용하는 사내 Java 실행환경이다.
RAG_AUTH_JVM_PATH=/Product/jdk/open/jdk-21.0.11+10/lib/server/libjvm.so
RAG_AUTH_JAVA_DIR=/Appl/chatllm/java
# 비워 두면 RAG_AUTH_JAVA_DIR 아래의 표준 7개 JAR와 디렉터리를 자동 조합한다.
RAG_AUTH_CLASSPATH=
# 사내 연계 계약이 변경된 환경에서만 다음 기본값을 override한다.
RAG_AUTH_INTERFACE_ID=IR_HI-FMSCLIENT_0001
RAG_AUTH_SYSTEM_ID=000164
# 최초 구축 시 데이터 관리 화면에서 권한을 등록할 관리자 사번(쉼표 구분).
# 권한 테이블에 관리자가 등록된 뒤에도 비상 복구 계정으로 동작하므로 최소 인원만 둔다.
RAG_AUTH_ADMIN_EMPLOYEE_IDS=IB1020
# 아래 Java wrapper 값은 provider=java_command를 유지하는 기존 환경에서만 사용한다.
RAG_AUTH_COMMAND=/srv/ecm-rag/bin/company-auth-wrapper
RAG_LLM_URL=http://192.168.1.31:8000/v1
RAG_LLM_MODEL=gemma-4-26B-A4B-it-qat-q4
RAG_LLM_API_KEY=
# LLM이 출력 길이 한도(finish_reason=length)에 도달했을 때 이어쓰기 최대 횟수.
RAG_LLM_MAX_CONTINUATIONS=3
# 로그분석 AI가 대량 로그에서 LLM 문맥으로 선별할 핵심 로그 문자 수.
# 실제 전달량은 profile의 models.llm.max_context_characters와 context window에도 제한된다.
RAG_INCIDENT_LOG_CONTEXT_CHARACTERS=16000
RAG_EMBED_URL=http://192.168.1.31:8200/v1/embeddings
RAG_EMBED_MODEL=bge-m3
RAG_EMBED_API_KEY=

# 해당 profile에서 사용하는 로컬 모델/DRM 경로.
RAG_RERANK_MODEL_PATH=/srv/models/bge-reranker-v2-m3
RAG_DOCLING_ARTIFACTS=/srv/models/docling
# EasyOCR 실행 장치: cpu, gpu, auto. gpu는 CUDA/MPS가 없으면 작업을 실패시킨다.
RAG_EASYOCR_DEVICE=cpu
RAG_DRM_COMMAND=/srv/drm/bin/decrypt-wrapper
RAG_DRM_ENABLED=true
RAG_JAVA_COMMAND=java
RAG_CFR_JAR_PATH=/srv/ecm-rag/tools/cfr-0.152.jar
RAG_WORKER_NAME=ecm-rag-worker-01

# 다중 사용자 부하 보호. 서버 CPU·메모리·DB 연결 한도에 맞춰 조정한다.
ECM_RAG_API_WORKERS=2
ECM_RAG_API_LIMIT_CONCURRENCY=100
ECM_RAG_API_BACKLOG=256
ECM_RAG_WORKER_PROCESSES=2
# 각 API/worker OS 프로세스가 보유할 PostgreSQL connection pool 상한이다.
# 총 상한은 대략 (API 프로세스 + 문서 worker 프로세스) × 이 값이다.
ECM_RAG_DB_POOL_MAX_SIZE=10

# API 수신 주소와 포트. 0.0.0.0은 사내 다른 PC의 호출을 받으므로 방화벽 제한이 필요하다.
ECM_RAG_HOST=0.0.0.0
ECM_RAG_PORT=8300
