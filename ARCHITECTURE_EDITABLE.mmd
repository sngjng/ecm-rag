flowchart TB
    U["사용자 로그인 / 업로드 / 검색 HTML"] --> API["FastAPI API 프로세스"]
    GUIDE_UI["장애 로그 해결 가이드 HTML"] --> API
    OW["OpenWebUI + LLM"] --> API
    API --> AUTH["Java 사내 로그인 Adapter"]

    subgraph ENDPOINTS["분리된 endpoint"]
        CRUD["Asset / Version / Relation CRUD"]
        INGEST["Upload / Job API"]
        SEARCH["Hybrid Search API"]
        GUIDE["Incident Guide API\n로그 축약 + 관리자 템플릿"]
        SESSION["Login / Session API"]
    end
    API --> CRUD
    API --> INGEST
    API --> SEARCH
    API --> GUIDE
    API --> SESSION

    CRUD --> PG[("PostgreSQL 17\nRDB + FTS + pg_trgm + pgvector")]
    SESSION --> PG
    INGEST --> AUDIT["사원정보 Upload Audit"]
    AUDIT --> PG
    INGEST --> FILES["격리 업로드 디렉터리"]
    INGEST --> QUEUE["ingestion_jobs 영속 Queue"]
    QUEUE --> PG

    subgraph WORKER["독립 Worker 프로세스"]
        CLAIM["Lease / Heartbeat / Retry"] --> DRM["Java DRM Adapter"]
        DRM --> ROUTER["유형별 Parser Router"]
        ROUTER --> DOC["Docling 문서 구조"]
        ROUTER --> INCIDENT["장애 구조화"]
        ROUTER --> TRACE["Error / Stack Frame"]
        ROUTER --> CODE["AST Code Symbol"]
        DOC --> CHUNK["Structure-aware Chunk"]
        INCIDENT --> CHUNK
        TRACE --> CHUNK
        CODE --> CHUNK
        CHUNK --> EMBED["Embedding API"]
    end

    FILES --> DRM
    QUEUE --> CLAIM
    EMBED --> PG
    CHUNK --> PG

    PG --> EXACT["Exact Identifier"]
    PG --> FTS["Full Text Search"]
    PG --> VECTOR["Vector Search"]
    EXACT --> RRF["RRF Fusion"]
    FTS --> RRF
    VECTOR --> RRF
    RRF --> RERANK["Optional Reranker"]
    RERANK --> SEARCH
    RERANK --> GUIDE
    GUIDE --> LLM["OpenAI 호환 LLM"]

    YAML["Base YAML + Environment Profile"] --> API
    YAML --> WORKER
